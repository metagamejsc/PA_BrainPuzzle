  m_Script: {fileID: 11500000, guid: 7e2c944d5d00d5c409283a0ea976b993, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  onEnter:
    m_PersistentCalls:
      m_Calls: []
  onExit:
    m_PersistentCalls:
      m_Calls: []
  singleHintAction: {fileID: 4072169273429281015}
  hintedAction: 1
  lastActionHint: 0
  hintEng: Drag the Cloak hanging on the Wall onto the Wolf.
  hintVi: "K\xE9o \xC1o Cho\xE0ng treo tr\xEAn t\u01B0\u1EDDng v\xE0o Con S\xF3i."
  hintSp: Arrastra la Capa colgada en la pared al Lobo.
  hintFr: "Fais glisser la Cape accroch\xE9e au mur vers le Loup."
  hintJa: "\u58C1\u306B\u639B\u304B\u3063\u3066\u3044\u308B\u30DE\u30F3\u30C8\u3092\u30AA\u30AA\u30AB\u30DF\u306B\u30C9\u30E9\u30C3\u30B0\u3057\u3066\u304F\u3060\u3055\u3044\u3002"
  hintKo: "\uBCBD\uC5D0 \uAC78\uB9B0 \uB9DD\uD1A0\uB97C \uB291\uB300\uC5D0\uAC8C
    \uB4DC\uB798\uADF8\uD558\uC138\uC694."
  hintTh: "\u0E25\u0E32\u0E01\u0E1C\u0E49\u0E32\u0E04\u0E25\u0E38\u0E21\u0E17\u0E35\u0E48\u0E41\u0E02\u0E27\u0E19\u0E2D\u0E22\u0E39\u0E48\u0E1A\u0E19\u0E1C\u0E19\u0E31\u0E07\u0E44\u0E1B\u0E17\u0E35\u0E48\u0E2B\u0E21\u0E32\u0E1B\u0E48\u0E32"
  hintCh: "\u628A\u6302\u5728\u5899\u4E0A\u7684\u6597\u7BF7\u62D6\u5230\u72FC\u8EAB\u4E0A\u3002"
  hintPo: "Arraste a Capa pendurada na parede at\xE9 o Lobo."
  hintGe: Ziehe den Umhang an der Wand zum Wolf.
  hintIt: Trascina il Mantello appeso al muro sul Lupo.
  hintIn: Seret Jubah yang tergantung di dinding ke Serigala.
  hintTu: "Duvarda as\u0131l\u0131 Pelerini Kurda s\xFCr\xFCkle."
  hintHi: "\u0926\u0940\u0935\u093E\u0930 \u092A\u0930 \u091F\u0902\u0917\u0940 \u091A\u093E\u0926\u0930
    \u0915\u094B \u092D\u0947\u0921\u093C\u093F\u092F\u0947 \u092A\u0930 \u0916\u0940\u0902\u091A\u0947\u0902\u0964"
  hintAr: "\u0627\u0633\u062D\u0628 \u0627\u0644\u0639\u0628\u0627\u0621\u0629 \u0627\u0644\u0645\u0639\u0644\u0642\u0629
    \u0639\u0644\u0649 \u0627\u0644\u062D\u0627\u0626\u0637 \u0625\u0644\u0649 \u0627\u0644\u0630\u0626\u0628."
  hintRu: "\u041F\u0435\u0440\u0435\u0442\u0430\u0449\u0438 \u041F\u043B\u0430\u0449,
    \u0432\u0438\u0441\u044F\u0449\u0438\u0439 \u043D\u0430 \u0441\u0442\u0435\u043D\u0435,
    \u043D\u0430 \u0412\u043E\u043B\u043A\u0430."
  skipAction: 0
  onStartRun:
    m_PersistentCalls:
      m_Calls: []
  onEndRun:
