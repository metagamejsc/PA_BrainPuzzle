  m_Name: 
  m_EditorClassIdentifier: 
  onEnter:
    m_PersistentCalls:
      m_Calls: []
  onExit:
    m_PersistentCalls:
      m_Calls: []
  singleHintAction: {fileID: 8207172252236990831}
  hintedAction: 1
  lastActionHint: 0
  hintEng: Drag the Shoes from the Monster's Feet onto the Girl.
  hintVi: "K\xE9o \u0110\xF4i Gi\xE0y \u1EDF ch\xE2n con qu\u1EF7 v\xE0o C\xF4 G\xE1i."
  hintSp: Arrastra los zapatos en los pies del demonio hacia la chica.
  hintFr: "Faites glisser les chaussures aux pieds du d\xE9mon vers la fille."
  hintJa: "\u60AA\u9B54\u306E\u8DB3\u306B\u3042\u308B\u9774\u3092\u5973\u306E\u5B50\u306B\u30C9\u30E9\u30C3\u30B0\u3059\u308B\u3002"
  hintKo: "\uC545\uB9C8\uC758 \uBC1C\uC5D0 \uC788\uB294 \uC2E0\uBC1C\uC744 \uC18C\uB140\uC5D0\uAC8C
    \uB04C\uC5B4\uB2E4 \uB193\uC73C\uC138\uC694."
  hintTh: "\u0E25\u0E32\u0E01\u0E23\u0E2D\u0E07\u0E40\u0E17\u0E49\u0E32\u0E17\u0E35\u0E48\u0E2D\u0E22\u0E39\u0E48\u0E1A\u0E19\u0E40\u0E17\u0E49\u0E32\u0E02\u0E2D\u0E07\u0E1B\u0E35\u0E28\u0E32\u0E08\u0E44\u0E1B\u0E17\u0E35\u0E48\u0E40\u0E14\u0E47\u0E01\u0E1C\u0E39\u0E49\u0E2B\u0E0D\u0E34\u0E07"
  hintCh: "\u5C06\u6076\u9B54\u811A\u4E0A\u7684\u978B\u5B50\u62D6\u5230\u5973\u5B69\u8EAB\u4E0A\u3002"
  hintPo: "Arraste os sapatos nos p\xE9s do dem\xF4nio para a garota."
  hintGe: "Ziehe die Schuhe an den F\xFC\xDFen des D\xE4mons zum M\xE4dchen."
  hintIt: Trascina le scarpe ai piedi del demone verso la ragazza.
  hintIn: Seret sepatu di kaki iblis ke gadis itu.
  hintTu: "\u015Eeytan\u0131n aya\u011F\u0131ndaki ayakkab\u0131lar\u0131 k\u0131za
    s\xFCr\xFCkle."
  hintHi: "\u0926\u093E\u0928\u0935 \u0915\u0947 \u092A\u0948\u0930\u094B\u0902 \u092E\u0947\u0902
    \u092A\u0939\u0928\u0947 \u091C\u0942\u0924\u0947 \u0915\u094B \u0932\u0921\u093C\u0915\u0940
    \u0915\u0940 \u0913\u0930 \u0916\u0940\u0902\u091A\u0947\u0902\u0964"
  hintAr: "\u0627\u0633\u062D\u0628 \u0627\u0644\u062D\u0630\u0627\u0621 \u0627\u0644\u0645\u0648\u062C\u0648\u062F
    \u0641\u064A \u0642\u062F\u0645 \u0627\u0644\u0634\u064A\u0637\u0627\u0646 \u0625\u0644\u0649
    \u0627\u0644\u0641\u062A\u0627\u0629."
  hintRu: "\u041F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u0435 \u043E\u0431\u0443\u0432\u044C
    \u0441 \u043D\u043E\u0433 \u0434\u0435\u043C\u043E\u043D\u0430 \u043A \u0434\u0435\u0432\u0443\u0448\u043A\u0435."
