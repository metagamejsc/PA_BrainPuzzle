    - target: {fileID: 4173579059407665228, guid: f61cfc57a21cf1f4bbb957db421b8e6a, type: 3}
      propertyPath: hintAr
      value: "\u0627\u0633\u062D\u0628 \u062D\u0630\u0627\u0621 \u0627\u0644\u0641\u062A\u0627\u0629
        \u0625\u0644\u0649 \u0628\u0627\u0644\u0648\u0646 \u0627\u0644\u0634\u0628\u062D."
      objectReference: {fileID: 0}
    - target: {fileID: 4173579059407665228, guid: f61cfc57a21cf1f4bbb957db421b8e6a, type: 3}
      propertyPath: hintCh
      value: "\u5C06\u5973\u5B69\u7684\u978B\u5B50\u62D6\u5230\u5E7D\u7075\u6C14\u7403\u4E0A\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 4173579059407665228, guid: f61cfc57a21cf1f4bbb957db421b8e6a, type: 3}
      propertyPath: hintFr
      value: "Faites glisser les chaussures de la fille vers le ballon fant\xF4me."
      objectReference: {fileID: 0}
    - target: {fileID: 4173579059407665228, guid: f61cfc57a21cf1f4bbb957db421b8e6a, type: 3}
      propertyPath: hintGe
      value: "Ziehe die Schuhe des M\xE4dchens zum Geisterballon."
      objectReference: {fileID: 0}
    - target: {fileID: 4173579059407665228, guid: f61cfc57a21cf1f4bbb957db421b8e6a, type: 3}
      propertyPath: hintHi
      value: "\u0932\u0921\u093C\u0915\u0940 \u0915\u0947 \u091C\u0942\u0924\u0947
        \u0915\u094B \u092D\u0942\u0924 \u0917\u0941\u092C\u094D\u092C\u093E\u0930\u0947
        \u0915\u0940 \u0913\u0930 \u0916\u0940\u0902\u091A\u0947\u0902\u0964"
      objectReference: {fileID: 0}
    - target: {fileID: 4173579059407665228, guid: f61cfc57a21cf1f4bbb957db421b8e6a, type: 3}
      propertyPath: hintIn
      value: Seret sepatu gadis itu ke balon hantu.
      objectReference: {fileID: 0}
    - target: {fileID: 4173579059407665228, guid: f61cfc57a21cf1f4bbb957db421b8e6a, type: 3}
      propertyPath: hintIt
      value: Trascina le scarpe della ragazza verso il palloncino fantasma.
      objectReference: {fileID: 0}
    - target: {fileID: 4173579059407665228, guid: f61cfc57a21cf1f4bbb957db421b8e6a, type: 3}
      propertyPath: hintJa
      value: "\u5973\u306E\u5B50\u306E\u9774\u3092\u30B4\u30FC\u30B9\u30C8\u98A8\u8239\u306B\u30C9\u30E9\u30C3\u30B0\u3059\u308B\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 4173579059407665228, guid: f61cfc57a21cf1f4bbb957db421b8e6a, type: 3}
      propertyPath: hintKo
      value: "\uC18C\uB140\uC758 \uC2E0\uBC1C\uC744 \uC720\uB839 \uD48D\uC120\uC5D0
        \uB04C\uC5B4\uB2E4 \uB193\uC73C\uC138\uC694."
      objectReference: {fileID: 0}
    - target: {fileID: 4173579059407665228, guid: f61cfc57a21cf1f4bbb957db421b8e6a, type: 3}
      propertyPath: hintPo
      value: "Arraste os sapatos da garota para o bal\xE3o fantasma."
      objectReference: {fileID: 0}
    - target: {fileID: 4173579059407665228, guid: f61cfc57a21cf1f4bbb957db421b8e6a, type: 3}
      propertyPath: hintRu
      value: "\u041F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u0435 \u043E\u0431\u0443\u0432\u044C
        \u0434\u0435\u0432\u0443\u0448\u043A\u0438 \u043A \u043F\u0440\u0438\u0437\u0440\u0430\u0447\u043D\u043E\u043C\u0443
