      propertyPath: hintTh
      value: "\u0E25\u0E32\u0E01\u0E23\u0E2D\u0E07\u0E40\u0E17\u0E49\u0E32\u0E02\u0E2D\u0E07\u0E40\u0E14\u0E47\u0E01\u0E1C\u0E39\u0E49\u0E2B\u0E0D\u0E34\u0E07\u0E44\u0E1B\u0E17\u0E35\u0E48\u0E25\u0E39\u0E01\u0E42\u0E1B\u0E48\u0E07\u0E1C\u0E35"
