    - target: {fileID: 4173579059407665228, guid: f61cfc57a21cf1f4bbb957db421b8e6a, type: 3}
      propertyPath: hintIn
      value: Seret gunting ke balon hantu.
      objectReference: {fileID: 0}
    - target: {fileID: 4173579059407665228, guid: f61cfc57a21cf1f4bbb957db421b8e6a, type: 3}
      propertyPath: hintIt
      value: Trascina le forbici verso il palloncino fantasma.
