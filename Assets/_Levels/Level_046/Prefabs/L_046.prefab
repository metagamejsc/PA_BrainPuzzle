    - target: {fileID: 4173579059407665228, guid: f61cfc57a21cf1f4bbb957db421b8e6a, type: 3}
      propertyPath: hintGe
      value: Ziehe die Schere zum Geisterballon.
      objectReference: {fileID: 0}
    - target: {fileID: 4173579059407665228, guid: f61cfc57a21cf1f4bbb957db421b8e6a, type: 3}
      propertyPath: hintHi
      value: "\u0915\u0948\u0902\u091A\u0940 \u0915\u094B \u092D\u0942\u0924 \u0917\u0941\u092C\u094D\u092C\u093E\u0930\u0947
